{
    "name": "relic-forge",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @relic-forge/web dev",
        "dev:api": "pnpm --filter @relic-forge/api dev",
        "build": "pnpm -r build",
        "lint": "pnpm -r lint",
        "test": "pnpm -r test",
        "simulate": "pnpm --filter @relic-forge/game-engine simulate",
        "db:up": "docker compose up -d",
        "db:down": "docker compose down"
    }
}